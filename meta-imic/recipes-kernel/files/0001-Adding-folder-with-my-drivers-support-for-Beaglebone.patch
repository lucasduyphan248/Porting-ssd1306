diff --git a/tmp/work-shared/beaglebone-yocto/kernel-source/drivers/bbb_my_drv/timer_drv_platform.c b/tmp/work-shared/beaglebone-yocto/kernel-source/drivers/bbb_my_drv/timer_drv_platform.c
new file mode 100644
index 0000000..4665328
--- /dev/null
+++ b/tmp/work-shared/beaglebone-yocto/kernel-source/drivers/bbb_my_drv/timer_drv_platform.c
@@ -0,0 +1,361 @@
+// SPDX-License-Identifier: GPL-2.0
+/* AM335x DMTimer: one overflow interrupt per second and a userspace counter. */
+
+#include <linux/cdev.h>
+#include <linux/bitops.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/fs.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/poll.h>
+#include <linux/spinlock.h>
+#include <linux/uaccess.h>
+#include <linux/wait.h>
+
+#define DRIVER_NAME "my_timer"
+#define CLASS_NAME "my_timer_class"
+#define TIMER_HZ 1
+
+#define TIMER_IRQSTATUS 0x28
+#define TIMER_IRQENABLE 0x2c
+#define TIMER_IRQENABLE_CLR 0x30
+#define TIMER_IRQWAKEEN 0x20
+#define TIMER_TIOCP_CFG 0x10
+#define TIMER_TCLR 0x38
+#define TIMER_TCRR 0x3c
+#define TIMER_TLDR 0x40
+
+#define TIMER_IRQ_OVF BIT(1)
+#define TIMER_TCLR_ST BIT(0)
+#define TIMER_TCLR_AR BIT(1)
+#define TIMER_TIOCP_CFG_SOFTRESET BIT(0)
+#define TIMER_TIOCP_CFG_ENAWAKEUP BIT(2)
+#define TIMER_TIOCP_CFG_IDLEMODE_SMART (2 << 3)
+#define TIMER_TIOCP_CFG_CLOCKACTIVITY BIT(9)
+
+#define TIMER_IOC_MAGIC 'T'
+#define TIMER_IOC_START _IO(TIMER_IOC_MAGIC, 1)
+#define TIMER_IOC_STOP _IO(TIMER_IOC_MAGIC, 2)
+#define TIMER_IOC_RESET _IO(TIMER_IOC_MAGIC, 3)
+#define TIMER_IOC_GET_COUNT _IOR(TIMER_IOC_MAGIC, 4, __u64)
+
+struct my_timer_dev {
+	struct device *dev;
+	void __iomem *base;
+	struct clk *clk;
+	unsigned long clock_rate;
+	u32 reload_value;
+	int irq;
+	dev_t devt;
+	struct cdev cdev;
+	struct class *class;
+	struct device *chardev;
+	spinlock_t lock;
+	wait_queue_head_t read_queue;
+	u64 counter;
+	bool event_pending;
+	bool running;
+};
+
+static void timer_write(struct my_timer_dev *timer, u32 offset, u32 value)
+{
+	writel(value, timer->base + offset);
+}
+
+static u32 timer_read(struct my_timer_dev *timer, u32 offset)
+{
+	return readl(timer->base + offset);
+}
+
+static int my_timer_enable_module(struct my_timer_dev *timer)
+{
+	u32 revision;
+	u32 config;
+	int i;
+
+	/* The functional register layout used below is DMTimer v2.  The
+	 * surrounding SYSC register still needs the v2 reset/enable sequence. */
+	revision = timer_read(timer, 0x00);
+	if (revision >> 16) {
+		config = timer_read(timer, TIMER_TIOCP_CFG);
+		config |= TIMER_TIOCP_CFG_SOFTRESET;
+		timer_write(timer, TIMER_TIOCP_CFG, config);
+
+		for (i = 0; i < 1000; i++) {
+			if (!(timer_read(timer, TIMER_TIOCP_CFG) &
+			      TIMER_TIOCP_CFG_SOFTRESET))
+				break;
+			udelay(1);
+		}
+		if (i == 1000)
+			return -ETIMEDOUT;
+
+		/* Type-2 SYSC: SMART_IDLE_WAKEUP, as used by the kernel timer
+		 * driver.  Do not set bit 0 here; it is SOFTRESET for type 2. */
+		timer_write(timer, TIMER_TIOCP_CFG, 3 << 2);
+	} else {
+		/* Type-1 SYSC configuration. */
+		timer_write(timer, TIMER_TIOCP_CFG,
+			     TIMER_TIOCP_CFG_CLOCKACTIVITY |
+			     TIMER_TIOCP_CFG_IDLEMODE_SMART |
+			     TIMER_TIOCP_CFG_ENAWAKEUP | BIT(0));
+	}
+
+	readl(timer->base + TIMER_TIOCP_CFG);
+	return 0;
+}
+
+static void my_timer_start_locked(struct my_timer_dev *timer)
+{
+	timer_write(timer, TIMER_IRQSTATUS, TIMER_IRQ_OVF);
+	timer_write(timer, TIMER_TLDR, timer->reload_value);
+	timer_write(timer, TIMER_TCRR, timer->reload_value);
+	timer_write(timer, TIMER_IRQENABLE, TIMER_IRQ_OVF);
+	timer_write(timer, TIMER_IRQWAKEEN, TIMER_IRQ_OVF);
+	timer_write(timer, TIMER_TCLR, TIMER_TCLR_ST | TIMER_TCLR_AR);
+	timer->running = true;
+}
+
+static void my_timer_stop_locked(struct my_timer_dev *timer)
+{
+	timer_write(timer, TIMER_TCLR, 0);
+	timer_write(timer, TIMER_IRQENABLE_CLR, TIMER_IRQ_OVF);
+	timer->running = false;
+}
+
+static irqreturn_t my_timer_irq(int irq, void *data)
+{
+	struct my_timer_dev *timer = data;
+	unsigned long flags;
+	u32 status;
+
+	status = timer_read(timer, TIMER_IRQSTATUS);
+	if (!(status & TIMER_IRQ_OVF))
+		return IRQ_NONE;
+
+	timer_write(timer, TIMER_IRQSTATUS, TIMER_IRQ_OVF);
+	spin_lock_irqsave(&timer->lock, flags);
+	if (timer->running) {
+		timer->counter++;
+		timer->event_pending = true;
+	}
+	spin_unlock_irqrestore(&timer->lock, flags);
+	wake_up_interruptible(&timer->read_queue);
+	return IRQ_HANDLED;
+}
+
+static int my_timer_open(struct inode *inode, struct file *file)
+{
+	file->private_data = container_of(inode->i_cdev,
+					 struct my_timer_dev, cdev);
+	return 0;
+}
+
+static ssize_t my_timer_read(struct file *file, char __user *user_buffer,
+				     size_t size, loff_t *offset)
+{
+	struct my_timer_dev *timer = file->private_data;
+	unsigned long flags;
+	u64 counter;
+	int ret;
+
+	if (size < sizeof(counter))
+		return -EINVAL;
+
+	if (file->f_flags & O_NONBLOCK) {
+		if (!READ_ONCE(timer->event_pending))
+			return -EAGAIN;
+	} else {
+		ret = wait_event_interruptible(timer->read_queue,
+					       READ_ONCE(timer->event_pending));
+		if (ret)
+			return ret;
+	}
+
+	spin_lock_irqsave(&timer->lock, flags);
+	counter = timer->counter;
+	timer->event_pending = false;
+	spin_unlock_irqrestore(&timer->lock, flags);
+
+	if (copy_to_user(user_buffer, &counter, sizeof(counter)))
+		return -EFAULT;
+	return sizeof(counter);
+}
+
+static __poll_t my_timer_poll(struct file *file, poll_table *wait)
+{
+	struct my_timer_dev *timer = file->private_data;
+	__poll_t mask = 0;
+
+	poll_wait(file, &timer->read_queue, wait);
+	if (READ_ONCE(timer->event_pending))
+		mask |= EPOLLIN | EPOLLRDNORM;
+	return mask;
+}
+
+static long my_timer_ioctl(struct file *file, unsigned int command,
+				   unsigned long argument)
+{
+	struct my_timer_dev *timer = file->private_data;
+	unsigned long flags;
+	u64 counter;
+
+	switch (command) {
+	case TIMER_IOC_START:
+		spin_lock_irqsave(&timer->lock, flags);
+		my_timer_start_locked(timer);
+		spin_unlock_irqrestore(&timer->lock, flags);
+		return 0;
+	case TIMER_IOC_STOP:
+		spin_lock_irqsave(&timer->lock, flags);
+		my_timer_stop_locked(timer);
+		spin_unlock_irqrestore(&timer->lock, flags);
+		return 0;
+	case TIMER_IOC_RESET:
+		spin_lock_irqsave(&timer->lock, flags);
+		timer->counter = 0;
+		timer->event_pending = false;
+		spin_unlock_irqrestore(&timer->lock, flags);
+		return 0;
+	case TIMER_IOC_GET_COUNT:
+		counter = READ_ONCE(timer->counter);
+		return copy_to_user((void __user *)argument, &counter,
+				    sizeof(counter)) ? -EFAULT : 0;
+	default:
+		return -ENOTTY;
+	}
+}
+
+static const struct file_operations my_timer_fops = {
+	.owner = THIS_MODULE,
+	.open = my_timer_open,
+	.read = my_timer_read,
+	.poll = my_timer_poll,
+	.unlocked_ioctl = my_timer_ioctl,
+};
+
+static int my_timer_probe(struct platform_device *pdev)
+{
+	struct my_timer_dev *timer;
+	int ret;
+
+	timer = devm_kzalloc(&pdev->dev, sizeof(*timer), GFP_KERNEL);
+	if (!timer)
+		return -ENOMEM;
+	timer->dev = &pdev->dev;
+	platform_set_drvdata(pdev, timer);
+	spin_lock_init(&timer->lock);
+	init_waitqueue_head(&timer->read_queue);
+
+	timer->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(timer->base))
+		return PTR_ERR(timer->base);
+
+	timer->clk = devm_clk_get(&pdev->dev, "fck");
+	if (IS_ERR(timer->clk))
+		return dev_err_probe(&pdev->dev, PTR_ERR(timer->clk),
+				     "failed to get fck\n");
+	ret = clk_prepare_enable(timer->clk);
+	if (ret)
+		return ret;
+	ret = my_timer_enable_module(timer);
+	if (ret)
+		goto err_disable_clk;
+
+	timer->clock_rate = clk_get_rate(timer->clk);
+	if (!timer->clock_rate) {
+		ret = -EINVAL;
+		dev_err(&pdev->dev, "invalid timer clock rate\n");
+		goto err_disable_clk;
+	}
+	timer->reload_value = (u32)(0xffffffffUL -
+				    timer->clock_rate / TIMER_HZ + 1);
+
+	timer->irq = platform_get_irq(pdev, 0);
+	if (timer->irq < 0) {
+		ret = timer->irq;
+		goto err_disable_clk;
+	}
+	ret = devm_request_irq(&pdev->dev, timer->irq, my_timer_irq,
+				       0, DRIVER_NAME, timer);
+	if (ret)
+		goto err_disable_clk;
+
+	ret = alloc_chrdev_region(&timer->devt, 0, 1, DRIVER_NAME);
+	if (ret)
+		goto err_disable_clk;
+	cdev_init(&timer->cdev, &my_timer_fops);
+	timer->cdev.owner = THIS_MODULE;
+	ret = cdev_add(&timer->cdev, timer->devt, 1);
+	if (ret)
+		goto err_unregister_region;
+
+	timer->class = class_create(THIS_MODULE, CLASS_NAME);
+	if (IS_ERR(timer->class)) {
+		ret = PTR_ERR(timer->class);
+		goto err_del_cdev;
+	}
+	timer->chardev = device_create(timer->class, &pdev->dev, timer->devt,
+					       NULL, DRIVER_NAME);
+	if (IS_ERR(timer->chardev)) {
+		ret = PTR_ERR(timer->chardev);
+		goto err_destroy_class;
+	}
+
+	spin_lock_irq(&timer->lock);
+	my_timer_start_locked(timer);
+	spin_unlock_irq(&timer->lock);
+	dev_info(&pdev->dev, "started: irq=%d clock=%luHz reload=0x%08x\n",
+		 timer->irq, timer->clock_rate, timer->reload_value);
+	return 0;
+
+err_destroy_class:
+	class_destroy(timer->class);
+err_del_cdev:
+	cdev_del(&timer->cdev);
+err_unregister_region:
+	unregister_chrdev_region(timer->devt, 1);
+err_disable_clk:
+	clk_disable_unprepare(timer->clk);
+	return ret;
+}
+
+static int my_timer_remove(struct platform_device *pdev)
+{
+	struct my_timer_dev *timer = platform_get_drvdata(pdev);
+
+	spin_lock_irq(&timer->lock);
+	my_timer_stop_locked(timer);
+	spin_unlock_irq(&timer->lock);
+	device_destroy(timer->class, timer->devt);
+	class_destroy(timer->class);
+	cdev_del(&timer->cdev);
+	unregister_chrdev_region(timer->devt, 1);
+	clk_disable_unprepare(timer->clk);
+	return 0;
+}
+
+static const struct of_device_id my_timer_of_match[] = {
+	{ .compatible = "ti,bbb-my-timer" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, my_timer_of_match);
+
+static struct platform_driver my_timer_driver = {
+	.probe = my_timer_probe,
+	.remove = my_timer_remove,
+	.driver = {
+		.name = DRIVER_NAME,
+		.of_match_table = my_timer_of_match,
+	},
+};
+
+module_platform_driver(my_timer_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("BBB");
+MODULE_DESCRIPTION("AM335x DMTimer interrupt counter driver");
diff --git a/tmp/work-shared/beaglebone-yocto/kernel-source/drivers/bbb_my_drv/uart_driver.c b/tmp/work-shared/beaglebone-yocto/kernel-source/drivers/bbb_my_drv/uart_driver.c
new file mode 100644
index 0000000..18e8a35
--- /dev/null
+++ b/tmp/work-shared/beaglebone-yocto/kernel-source/drivers/bbb_my_drv/uart_driver.c
@@ -0,0 +1,241 @@
+//UART platform driver
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/of.h>
+#include <linux/io.h>
+#include <linux/fs.h>
+#include <linux/miscdevice.h>
+#include <linux/uaccess.h>
+#include <linux/interrupt.h>
+#include <linux/wait.h>
+#include <linux/spinlock.h>
+#include <linux/pm_runtime.h>
+#include <linux/serial_reg.h>
+
+#include "my_drv.h"
+
+#define DRIVER_NAME "my_uart"
+#define BUFFER_SIZE 100 //size of circular buffer
+
+//Circular buffer for received data
+struct circ_buff{
+    char buff[BUFFER_SIZE];
+    int read_pos;
+    int write_pos;
+    int length;
+};
+
+struct hw_serial_dev {
+    void __iomem *regs;
+    struct miscdevice mDev;
+    int irq;
+    struct circ_buff buf;
+    wait_queue_head_t waitQ;
+    spinlock_t lock;
+    unsigned long irqFlags;
+};
+
+// register access helpers
+static unsigned int reg_read(struct hw_serial_dev *dev, int offset){
+    return ioread32(dev->regs + offset);
+}
+
+static void reg_write(struct hw_serial_dev *dev, int offset, unsigned int value){
+    iowrite32(value, dev->regs + offset);
+}
+
+//Write a character to circular buffer
+static void write_circ_buff(char c, struct hw_serial_dev *dev){
+    spin_lock_irqsave(&dev->lock, dev->irqFlags);
+    if (dev->buf.length < BUFFER_SIZE) {
+        dev->buf.buff[dev->buf.write_pos] = c;
+        dev->buf.write_pos = (dev->buf.write_pos + 1) % BUFFER_SIZE;
+        dev->buf.length++;
+    }
+    spin_unlock_irqrestore(&dev->lock, dev->irqFlags);
+}
+
+//REad a character from circular buffer
+static char read_circ_buff(struct hw_serial_dev *dev){
+    char c = '\0';
+    spin_lock_irqsave(&dev->lock, dev->irqFlags);
+    if (dev->buf.length > 0){
+        c = dev->buf.buff[dev->buf.read_pos];
+        dev->buf.read_pos = (dev->buf.read_pos + 1) % BUFFER_SIZE;
+        dev->buf.length--;
+    }
+    spin_unlock_irqrestore(&dev->lock, dev->irqFlags);
+    return c;
+}
+
+//File operations
+static int my_open(struct inode *inode, struct file *file){
+    pr_info("UART device opened\n");
+    return 0;
+}
+
+static int my_release(struct inode *inode, struct file *file){
+    pr_info("UART device release\n");
+    return 0;
+}
+
+static ssize_t my_read(struct file *file, char __user *buf, size_t size, loff_t *loff){
+    char c;
+    struct miscdevice *mdev = (struct miscdevice *)file->private_data;
+    struct hw_serial_dev *dev = container_of(mdev, struct hw_serial_dev, mDev);
+
+    wait_event_interruptible(dev->waitQ, dev->buf.length > 0);
+
+    c = read_circ_buff(dev);
+    if (copy_to_user(buf, &c, 1))
+        return -EFAULT;
+    
+    return 1;
+}
+
+static ssize_t my_write(struct file *file, const char __user *buf, size_t len, loff_t *loff){
+    size_t i;
+    struct miscdevice *mdev = (struct miscdevice *)file->private_data;
+    struct hw_serial_dev *dev = container_of(mdev, struct hw_serial_dev, mDev);
+
+    char kmem[BUFFER_SIZE];
+    if (len > BUFFER_SIZE)
+        return -EINVAL;
+
+    if (copy_from_user(kmem, buf, len))
+        return -EFAULT;
+
+    for (i = 0; i < len; i++)
+        reg_write(dev, UART_THR, kmem[i]);
+    
+    return len;
+}
+
+static long my_unlocked_ioctl(struct file *file, unsigned int cmd, unsigned long arg){
+    return -ENOTTY; // Dont need ioctl commands
+}
+
+//IRQ handler for UART RX
+static irqreturn_t uart_handler(int irq, void *dev_id){
+    struct hw_serial_dev*dev = dev_id;
+
+    while (reg_read(dev,UART_LSR) & UART_LSR_DR){
+        char recv = reg_read(dev, UART_RHR);
+        write_circ_buff(recv, dev);
+        wake_up(&dev->waitQ);
+    }
+
+    return IRQ_HANDLED;
+}
+
+//FILE operations structure
+static const struct file_operations my_fops = {
+       .owner   = THIS_MODULE,
+       .open    = my_open,
+       .read    = my_read,
+       .write   = my_write,
+       .release = my_release,
+       .unlocked_ioctl = my_unlocked_ioctl,
+};
+
+//Probe function: initializes UART device
+static int my_uart_probe(struct platform_device *pdev){
+    struct hw_serial_dev *dev;
+    struct resource *res;
+    unsigned int uartclk, baud_divisor, chan;
+    char *irq_name;
+    int ret;
+
+    dev = devm_kzalloc(&pdev->dev, sizeof(*dev), GFP_KERNEL);
+    if (!dev)
+        return -ENOMEM;
+    platform_set_drvdata(pdev, dev);
+
+    //Map UART registers
+    res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+    dev->regs = devm_ioremap_resource(&pdev->dev, res);
+    if (IS_ERR(dev->regs))
+        return PTR_ERR(dev->regs);
+
+    //Read channel and clock frequency from device tree
+    of_property_read_u32(pdev->dev.of_node, "chan", &chan);
+    of_property_read_u32(pdev->dev.of_node, "clock-frequency", &uartclk);
+    baud_divisor = uartclk / 16 / 115200;
+
+    //request IRQ
+    irq_name = devm_kasprintf(&pdev->dev, GFP_KERNEL, "uartirq-%d", chan);
+    res = platform_get_resource(pdev, IORESOURCE_IRQ, 0);
+    dev->irq = res->start;
+
+    ret = devm_request_irq(&pdev->dev, dev->irq, uart_handler, 0, irq_name, dev);
+    if (ret)
+        return ret;
+    
+    //enable runtime power management
+    pm_runtime_enable(&pdev->dev);
+    pm_runtime_get_sync(&pdev->dev);
+
+    //UART initialization sequence
+    reg_write(dev, UART_EFR, reg_read(dev, UART_EFR) | 0x10);// enable enhanced features
+    reg_write(dev, UART_LCR, 0x83);                          // enable access to DLL/DLH
+    reg_write(dev, UART_DLL, baud_divisor & 0xFF);
+    reg_write(dev, UART_DLH, (baud_divisor >> 8) & 0x3F);
+    reg_write(dev, UART_FCR, 0x07);                          // enable and clear FIFOs
+    reg_write(dev, UART_IER, UART_IER_RDI | UART_IER_THRI);  // enable RX/TX interrupts
+    reg_write(dev, UART_LCR, 0x03);                          // 8-bit data, disable DLL/DLH access
+    
+    //setup misc device
+    dev->mDev.minor = MISC_DYNAMIC_MINOR;
+    dev->mDev.name = devm_kasprintf(&pdev->dev, GFP_KERNEL, "uart-%d", chan);
+    dev->mDev.fops = &my_fops;
+
+    ret = misc_register(&dev->mDev);
+    if (ret)
+        return ret;
+    
+    //Initialize buffer and synchronization primitives
+    init_waitqueue_head(&dev->waitQ);
+    spin_lock_init(&dev->lock);
+    dev->buf.read_pos = 0;
+    dev->buf.write_pos = 0;
+    dev->buf.length = 0;
+
+    return 0;
+}
+
+//remove function: cleans up resources
+static int my_uart_remove(struct platform_device *pdev){
+    struct hw_serial_dev *dev = platform_get_drvdata(pdev);
+    misc_deregister(&dev->mDev);
+    pm_runtime_put_sync(&pdev->dev);
+    pm_runtime_disable(&pdev->dev);
+    return 0;
+}
+
+//device tree match table
+static const struct of_device_id my_uart_of_match[] = {
+    { .compatible = "ti,am3358-my-uart" },
+    {}
+};
+MODULE_DEVICE_TABLE(of, my_uart_of_match);
+
+//Platform diver definition
+static struct platform_driver my_uart_driver = {
+       .probe = my_uart_probe,
+       .remove = my_uart_remove,
+       .driver = {
+               .name = DRIVER_NAME,
+               .of_match_table = my_uart_of_match,
+       },
+};
+
+//Register the platform driver
+module_platform_driver(my_uart_driver);
+
+//module metadata
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("BBB_Lucas");
+MODULE_DESCRIPTION("Improved UART driver for Beaglebone Black");
+
+
