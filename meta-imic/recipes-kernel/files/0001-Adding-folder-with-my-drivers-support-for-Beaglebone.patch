index 0000000..fe546b5
--- /dev/null
+++ b/tmp/work-shared/beaglebone-yocto/kernel-source/drivers/bbb_my_drv/my_drv.c
@@ -0,0 +1,194 @@
+/*Character device driver*/
+
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/fs.h>
+#include <linux/cdev.h>
+#include <linux/device.h>
+#include <linux/uaccess.h>
+#include <linux/kdev_t.h>
+#include <linux/ctype.h>
+#include <my_drv.h>
+
+static dev_t dev_num;
+static struct class *my_class;
+static struct device *my_device;
+static struct cdev my_cdev;
+ 
+static char kernel_buffer[BUFFER_SIZE];
+static size_t buffer_len;
+
+static int my_open(struct inode *inode, struct file *file)
+{
+       pr_info("%s: device opened\n", DRIVER_NAME);
+       return 0;
+}
+
+static int my_release(struct inode *inode, struct file *file)
+{
+       pr_info("%s: device released\n", DRIVER_NAME);
+       return 0;
+}
+
+static ssize_t my_read(struct file *file, char __user *ubuf, size_t size, loff_t *off)
+{
+       size_t available;
+       size_t to_copy;
+
+       if (*off >= buffer_len)
+               return 0;
+
+       available = buffer_len - *off;
+       to_copy = min(size, available);
+
+       if (copy_to_user(ubuf, kernel_buffer + *off, to_copy))
+               return -EFAULT;
+
+       *off += to_copy;
+       pr_info("%s: read request (%zu bytes)\n", DRIVER_NAME, size);
+       return to_copy;
+}
+
+static ssize_t my_write(struct file *file, const char __user *ubuf, size_t size, loff_t *off)
+{
+       if (size > BUFFER_SIZE - 1)
+       {
+               return -EINVAL;
+       }
+       if (copy_from_user(kernel_buffer, ubuf, size))
+       {
+               return -EFAULT;
+       }
+
+       buffer_len = size;
+       kernel_buffer[size] = '\0';
+
+       pr_info("%s: write request (%zu bytes)\n", DRIVER_NAME, size);
+
+       return size; /* report all bytes written */
+}
+
+static long my_ioctl(struct file *file, unsigned int cmd, unsigned long u_addr)
+{
+       size_t i;
+       size_t len;
+
+       (void)u_addr;
+
+       switch(cmd)
+       {
+               case IOCTL_STRING_CAPITALIZE:
+               {
+                       len = strnlen(kernel_buffer, BUFFER_SIZE);
+                       for(i = 0; i < len; i++){
+                               if (kernel_buffer[i] >= 'a' && kernel_buffer[i] <= 'z'){
+                                       kernel_buffer[i] -= 32;
+                               }
+                       }
+                       buffer_len = len;
+                       pr_info("%s: buffer capitalized: %s\n", DRIVER_NAME, kernel_buffer);
+                       break;
+               }
+               case IOCTL_STRING_REVERSE:
+               {
+                       size_t j;
+                       char temp;
+
+                       len = strnlen(kernel_buffer, BUFFER_SIZE);
+                       if (len > 0) {
+                               for(i = 0, j = len - 1; i < j; i++, j--){
+                                       temp = kernel_buffer[i];
+                                       kernel_buffer[i] = kernel_buffer[j];
+                                       kernel_buffer[j] = temp;
+                               }
+                       }
+                       buffer_len = len;
+                       pr_info("%s: buffer reverse: %s\n", DRIVER_NAME, kernel_buffer);
+                       break;
+               }
+               default:
+               {
+                       printk("[ERROR] unsupport function\n");
+                       return -EINVAL;
+               }
+       }
+
+       return 0;
+}
+
+
+static const struct file_operations my_fops = {
+       .owner   = THIS_MODULE,
+       .open    = my_open,
+       .read    = my_read,
+       .write   = my_write,
+       .release = my_release,
+       .unlocked_ioctl = my_ioctl,
+};
+
+/* -------------------------------------------------------------------- */
+
+static int __init my_drv_init(void)
+{
+       int ret;
+
+       pr_info("%s: initializing\n", DRIVER_NAME);
+
+       /* Allocate device number (dynamic major, minor = 0) */
+       ret = alloc_chrdev_region(&dev_num, 0, 1, "my_driver");
+       if (ret < 0){
+               printk("[ERROR] %s. Fail to alloc_chrdev_region\n", __func__);
+               return ret;
+       }
+       /* Initialize and add cdev */
+       cdev_init(&my_cdev, &my_fops);
+       ret = cdev_add(&my_cdev, dev_num, 1);
+       if (ret < 0){
+               printk("[ERROR] %s. Fail to init and add cdev\n", __func__);
+               goto err_unregister_region;
+       }
+       /* Create class */
+       my_class = class_create(THIS_MODULE, CLASS_NAME);
+       if (IS_ERR(my_class)){
+               pr_err("%s: class_create failed\n", DRIVER_NAME);
+               ret = PTR_ERR(my_class);
+               goto err_del_cdev;
+       }
+       /* Create device node /dev/my_drv */
+       /* tạo ra /dev/my_drv */
+       my_device = device_create(my_class, NULL, dev_num, NULL, DRIVER_NAME);
+       if (IS_ERR(my_device)){
+               pr_err("%s: device_create failed\n", DRIVER_NAME);
+               ret = PTR_ERR(my_device);
+               goto err_destroy_class;
+       }
+
+       return 0;
+
+/* --- Error cleanup --- */
+err_destroy_class:
+       class_destroy(my_class);
+err_del_cdev:
+       cdev_del(&my_cdev);
+err_unregister_region:
+       unregister_chrdev_region(dev_num, 1);
+       return ret;
+}
+
+static void __exit my_drv_exit(void)
+{
+       pr_info("%s: exiting\n", DRIVER_NAME);
+       device_destroy(my_class, dev_num);
+       class_destroy(my_class);
+       cdev_del(&my_cdev);
+       unregister_chrdev_region(dev_num, 1);
+}
+
+/* -------------------------------------------------------------------- */
+
+module_init(my_drv_init);
+module_exit(my_drv_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("BBB_TrN");
+MODULE_DESCRIPTION("Simple standalone character driver demo");
