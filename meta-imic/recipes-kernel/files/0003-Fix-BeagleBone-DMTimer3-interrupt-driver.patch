-       if (tdev)
-               dev_info(tdev->dev, "device released\n");
-       return 0;
+	timer_write(timer, TIMER_IRQSTATUS, TIMER_IRQ_OVF);
+	timer_write(timer, TIMER_TLDR, timer->reload_value);
+	timer_write(timer, TIMER_TCRR, timer->reload_value);
+	timer_write(timer, TIMER_IRQENABLE, TIMER_IRQ_OVF);
+	timer_write(timer, TIMER_IRQWAKEEN, TIMER_IRQ_OVF);
+	timer_write(timer, TIMER_TCLR, TIMER_TCLR_ST | TIMER_TCLR_AR);
+	timer->running = true;
 }
 
-static ssize_t my_read(struct file *file, char __user *ubuf, size_t size, loff_t *off)
+static void my_timer_stop_locked(struct my_timer_dev *timer)
 {
-       struct my_timer_dev *tdev = file->private_data;
-       size_t available;
-       size_t to_copy;
-
-       if (!tdev)
-               return -ENODEV;
-
-       if (*off >= tdev->buffer_len)
-               return 0;
-
-       available = tdev->buffer_len - *off;
-       to_copy = min(size, available);
-
-       if (copy_to_user(ubuf, tdev->buffer + *off, to_copy))
-               return -EFAULT;
-
-       *off += to_copy;
-       return to_copy;
+	timer_write(timer, TIMER_TCLR, 0);
+	timer_write(timer, TIMER_IRQENABLE_CLR, TIMER_IRQ_OVF);
+	timer->running = false;
 }
 
-static ssize_t my_write(struct file *file, const char __user *ubuf, size_t size, loff_t *off)
+static irqreturn_t my_timer_irq(int irq, void *data)
 {
-       struct my_timer_dev *tdev = file->private_data;
-
-       (void)off;
-
-       if (!tdev)
-               return -ENODEV;
-
-       if (size > BUFFER_SIZE - 1)
-               return -EINVAL;
-
-       if (copy_from_user(tdev->buffer, ubuf, size))
-               return -EFAULT;
-
-       tdev->buffer_len = size;
-       tdev->buffer[size] = '\0';
-       return size;
+	struct my_timer_dev *timer = data;
+	unsigned long flags;
+	u32 status;
+
+	status = timer_read(timer, TIMER_IRQSTATUS);
+	if (!(status & TIMER_IRQ_OVF))
+		return IRQ_NONE;
+
+	timer_write(timer, TIMER_IRQSTATUS, TIMER_IRQ_OVF);
+	spin_lock_irqsave(&timer->lock, flags);
+	if (timer->running) {
+		timer->counter++;
+		timer->event_pending = true;
+	}
+	spin_unlock_irqrestore(&timer->lock, flags);
+	wake_up_interruptible(&timer->read_queue);
+	return IRQ_HANDLED;
 }
 
-static void timer_config_compare_mode(struct my_timer_dev *tdev)
